% Contact Information
\sidebarheading{\colorheading{Con}{tact}}

\contactitem{\faPhone}{<VAR>contact.phone|latex_escape</VAR>}
\contactitem{\faEnvelope}{\href{mailto:<VAR>contact.email</VAR>}{<VAR>contact.email|latex_escape</VAR>}}
<BLOCK>if has_linkedin</BLOCK>
\contactitem{\faLinkedin}{\href{<VAR>contact.linkedin</VAR>}{LinkedIn}}
<BLOCK>endif</BLOCK>
<BLOCK>if has_github</BLOCK>
\contactitem{\faGithub}{\href{<VAR>contact.github</VAR>}{GitHub}}
<BLOCK>endif</BLOCK>
\contactitem{\faMapMarker}{<VAR>contact.location|latex_escape</VAR>}

