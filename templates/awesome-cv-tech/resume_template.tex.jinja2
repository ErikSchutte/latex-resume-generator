% Name and Title
\begin{center}
<BLOCK>set escaped_name = contact.name|latex_escape</BLOCK>
<BLOCK>set first_name = escaped_name.split()[0] if ' ' in escaped_name else escaped_name</BLOCK>
<BLOCK>set last_name = ' '.join(escaped_name.split()[1:]) if ' ' in escaped_name else ''</BLOCK>
<BLOCK>if last_name</BLOCK>
{\fontsize{20}{24}\selectfont\color{black}<VAR>first_name</VAR> \textbf{<VAR>last_name</VAR>}}\\[0.15em]
<BLOCK>else</BLOCK>
{\fontsize{20}{24}\selectfont\color{black}\textbf{<VAR>first_name</VAR>}}\\[0.15em]
<BLOCK>endif</BLOCK>
{\fontsize{10}{12}\selectfont\color{black}<VAR>contact.position_title|latex_escape</VAR>}
\end{center}

