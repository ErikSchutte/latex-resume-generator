{\linespread{0.7}\selectfont\textbf{\color{black}\skillcatheading{Clo}{ud Service Providers}}\\[0.002em]
<BLOCK>for skill in skill_list</BLOCK>
$\circ$ \color{text}<VAR>skill|latex_escape</VAR>\\[-0.005em]<BLOCK>endfor</BLOCK>}
\vspace{0.005em}
<BLOCK>elif category == "Container Orchestration & Kubernetes"</BLOCK>
{\linespread{0.7}\selectfont\textbf{\color{black}\skillcatheading{Con}{tainer Orchestration \& Kubernetes}}\\[0.002em]
<BLOCK>for skill in skill_list</BLOCK>
$\circ$ \color{text}<VAR>skill|latex_escape</VAR>\\[-0.005em]<BLOCK>endfor</BLOCK>}
\vspace{0.005em}
<BLOCK>elif category == "Infrastructure & Security"</BLOCK>
{\linespread{0.7}\selectfont\textbf{\color{black}\skillcatheading{Inf}{rastructure \& Security}}\\[0.002em]
<BLOCK>for skill in skill_list</BLOCK>
$\circ$ \color{text}<VAR>skill|latex_escape</VAR>\\[-0.005em]<BLOCK>endfor</BLOCK>}
\vspace{0.005em}
<BLOCK>else</BLOCK>
{\linespread{0.7}\selectfont\textbf{\color{black}<VAR>category|latex_escape</VAR>}\\[0.002em]
<BLOCK>for skill in skill_list</BLOCK>
$\circ$ \color{text}<VAR>skill|latex_escape</VAR>\\[-0.005em]<BLOCK>endfor</BLOCK>}
\vspace{0.005em}
<BLOCK>endif</BLOCK>
<BLOCK>endif</BLOCK>
<BLOCK>endfor</BLOCK>

<BLOCK>if has_certifications</BLOCK>
\vspace{0.2em}
\sidebarheading{\colorheading{Cer}{tifications}}

<BLOCK>for cert in certifications</BLOCK>
\textbf{\color{black}<VAR>cert.name|latex_escape</VAR>}<BLOCK>if cert.date</BLOCK> {\small\color{accent}(<VAR>cert.date|latex_escape</VAR>)}<BLOCK>endif</BLOCK>\\
<BLOCK>if cert.issuer</BLOCK>{\small\color{text}<VAR>cert.issuer|latex_escape</VAR>}\\<BLOCK>endif</BLOCK>[0.2em]
<BLOCK>endfor</BLOCK>
<BLOCK>endif</BLOCK>

% Education in Sidebar
\needspace{10\baselineskip}
\vspace{0.2em}
\sidebarheading{\colorheading{Edu}{cation}}

<BLOCK>for edu in education</BLOCK>
\textbf{\color{black}<VAR>edu.degree|latex_escape</VAR>}\\
